# SupportIQ Backend Configuration
PROJECT_NAME="SupportIQ"
API_V1_STR="/api"
SECRET_KEY="supportiq-super-secret-jwt-key-for-local-demo-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="sqlite:///./supportiq.db"

# Storage
UPLOAD_DIR="./uploads"

# AI Configuration (Optional: runs in Demo Retrieval Mode if omitted)
# Supported providers: "gemini", "groq", "openai", "demo"
AI_PROVIDER="demo"
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENAI_API_KEY=""
AI_MODEL=""

# Retrieval Settings
RETRIEVAL_CONFIDENCE_THRESHOLD=0.35
MAX_RETRIEVAL_CHUNKS=5
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# CORS
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
